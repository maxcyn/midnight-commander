PORT=3000
# Bearer token CREAO sends when calling your tools. Generate with: openssl rand -hex 24
TOOL_TOKEN=change-me
# Public tunnel URL (changes whenever the tunnel restarts)
PUBLIC_URL=https://example.trycloudflare.com
# Random string CREAO echoes back on the webhook
WEBHOOK_SECRET=change-me
# From the CREAO agent page
CREAO_API_KEY=capi_...
CREAO_APP_ID=
# Sentry region host (EU org)
SENTRY_BASE_URL=https://de.sentry.io
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Signing secret of the Sentry integration that delivers alert webhooks (Client Secret)
SENTRY_WEBHOOK_SECRET=
# Demo app, read-only (probe token from demo-app/.env). The responder never gets the fault-injection token.
DEMO_APP_URL=http://localhost:4000
DEMO_PROBE_TOKEN=
INVESTIGATION_BUDGET_MS=180000
PRIMARY_RESPONDER=primary-engineer
BACKUP_RESPONDER=backup-engineer
