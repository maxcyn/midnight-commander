PORT=3000
# Bearer token CREAO sends when calling your tools. Generate with: openssl rand -hex 24
TOOL_TOKEN=change-me
# Separate operator-only credential for /debug/* test endpoints.
DEBUG_TOKEN=change-me
# Public tunnel URL (changes whenever the tunnel restarts)
PUBLIC_URL=https://example.trycloudflare.com
# Random string CREAO echoes back on the webhook
WEBHOOK_SECRET=change-me
# From the CREAO agent page
CREAO_API_BASE=https://agent.creao.ai/api/v1
CREAO_API_KEY=capi_...
CREAO_APP_ID=
# Sentry region host (EU org)
SENTRY_BASE_URL=https://de.sentry.io
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Signing secret of the Sentry integration that delivers alert webhooks (Client Secret)
SENTRY_WEBHOOK_SECRET=
# Demo app, read-only (probe token from demo-app/.env). The responder never gets the fault-injection token.
DEMO_APP_URL=http://localhost:4000
DEMO_PROBE_TOKEN=
INVESTIGATION_BUDGET_MS=180000
PRIMARY_RESPONDER=primary-engineer
BACKUP_RESPONDER=backup-engineer
# Dashboard is a separate human-only credential.
DASHBOARD_TOKEN=change-me
# Voice functions also validate Retell's request signature.
VOICE_TOOL_TOKEN=change-me
# Out-of-band PIN for an enrolled responder; never put it in the Retell prompt.
VOICE_APPROVAL_PIN=
PRIMARY_PHONE=
BACKUP_PHONE=
# Must equal demo-app/.env ACTION_TOKEN. Never give this token to CREAO or Retell.
DEMO_ACTION_TOKEN=
# Retell requires a voice-capable number configured with the supported Photon/SIP setup.
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=
# Set true only after the real phone integration and responders are configured.
PHONE_AUTO_NOTIFY=false
